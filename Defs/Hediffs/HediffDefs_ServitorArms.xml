<Defs>
<HediffDef ParentName="AddedBodyPartBase">
  <defName>Seg_Servitors_MiningArm_Hediff</defName>
  <label>servitor mining arm</label>
  <labelNoun>a servitor mining arm</labelNoun>
  <description>An installed augmetic replacement arm designed for mining servitors. The arm is composed of industrial micro-las emitters, several drill bits, scoops, and filters to sieve rare minerals from less valuable rock.</description>
  <spawnThingOnRemoved>Seg_Servitors_MiningArm</spawnThingOnRemoved>
  <hediffClass>Seg.Hediff_SkillOffsetDisplay</hediffClass>
  <addedPartProps>
    <solid>true</solid>
    <partEfficiency>1</partEfficiency>
    <betterThanNatural>true</betterThanNatural>
  </addedPartProps>
  <comps>
        <li Class="Seg.HediffCompProperties_SkillOffset">
            <skills>
                <li>
                    <skill>Mining</skill>
                    <offset>2</offset>
                </li>
                <li>
                    <skill>Melee</skill>
                    <offset>4</offset>
                </li>
                <li>
                    <skill>Shooting</skill>
                    <offset>-6</offset>
                </li>
                <li>
                    <skill>Cooking</skill>
                    <offset>-6</offset>
                </li>
                <li>
                    <skill>Plants</skill>
                    <offset>-6</offset>
                </li>
                <li>
                    <skill>Animals</skill>
                    <offset>-6</offset>
                </li>
                <li>
                    <skill>Crafting</skill>
                    <offset>-6</offset>
                </li>
                <li>
                    <skill>Artistic</skill>
                    <offset>-6</offset>
                </li>
                 <li>
                    <skill>Medicine</skill>
                    <offset>-6</offset>
                </li>
            </skills>
        </li>
    </comps>



  <stages>
    <li>
      <statOffsets>
        <DeepDrillingSpeed>.50</DeepDrillingSpeed>
        <MiningSpeed>.20</MiningSpeed>
        <MiningYield>.50</MiningYield>
        <MiningSkillOffset>2</MiningSkillOffset>
        <MeleeSkillOffset>4</MeleeSkillOffset>
        <CookingSkillOffset>-6</CookingSkillOffset>
        <PlantsSkillOffset>-6</PlantsSkillOffset>
        <AnimalsSkillOffset>-6</AnimalsSkillOffset>
        <CraftingSkillOffset>-6</CraftingSkillOffset>
        <ArtisticSkillOffset>-6</ArtisticSkillOffset>
        <MedicineSkillOffset>-6</MedicineSkillOffset>

      </statOffsets>
      <painOffset>0.01</painOffset>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
    </li>
  </stages>
</HediffDef>
<HediffDef ParentName="AddedBodyPartBase">
  <defName>Seg_Servitors_IndustrialArm_Hediff</defName>
  <label>servitor industrial arm</label>
  <labelNoun>a servitor industrial arm</labelNoun>
  <description>An installed augmetic replacement arm designed for manufactorum and construction servitors. The industrial version of the servitor arm has a clamp, a built in fusion welder and robust secondary manipulators to allow for better construction and crafting.</description>
  <spawnThingOnRemoved>Seg_Servitors_IndustrialArm</spawnThingOnRemoved>
  <hediffClass>Seg.Hediff_SkillOffsetDisplay</hediffClass>
  <addedPartProps>
    <solid>true</solid>
    <partEfficiency>1</partEfficiency>
    <betterThanNatural>true</betterThanNatural>
  </addedPartProps>
  <comps>
        <li Class="Seg.HediffCompProperties_SkillOffset">
            <skills>
                <li>
                    <skill>Construction</skill>
                    <offset>4</offset>
                </li>
                <li>
                    <skill>Crafting</skill>
                    <offset>4</offset>
                </li>
                
                <li>
                    <skill>Plants</skill>
                    <offset>-6</offset>
                </li>
                <li>
                    <skill>Artistic</skill>
                    <offset>-6</offset>
                </li>
                 <li>
                    <skill>Medicine</skill>
                    <offset>-6</offset>
                </li>
            </skills>
        </li>
    </comps>



  <stages>
    <li>
      <statOffsets>
        
        <WorkSpeedGlobal>0.10</WorkSpeedGlobal>
        <SmeltingSpeed>0.20</SmeltingSpeed>
        <PlantsSkillOffset>-6</PlantsSkillOffset>
        <ConstructionSkillOffset>4</ConstructionSkillOffset>
        <CraftingSkillOffset>4</CraftingSkillOffset>
        <ArtisticSkillOffset>-6</ArtisticSkillOffset>
        <MedicineSkillOffset>-6</MedicineSkillOffset>

      </statOffsets>
      <painOffset>0.03</painOffset>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.1</offset>
          </li>
        </capMods>
    </li>
  </stages>
</HediffDef>
<HediffDef ParentName="AddedBodyPartBase">
  <defName>Seg_Servitors_AgriArm_Hediff</defName>
  <label>servitor agri-arm</label>
  <labelNoun>an agricultural servitor arm</labelNoun>
  <description>An installed augmetic replacement arm. The servitor agri-arm has a built in seed planter and fertilizer spreader to make farming easier. The fingers are replaced with multiple mechascythes that greatly speed up gathering work, but destroy a small amount of the harvest.</description>
  <spawnThingOnRemoved>Seg_Servitors_AgriArm</spawnThingOnRemoved>
  <hediffClass>Seg.Hediff_SkillOffsetDisplay</hediffClass>
  <addedPartProps>
    <solid>true</solid>
    <partEfficiency>1</partEfficiency>
    <betterThanNatural>true</betterThanNatural>
  </addedPartProps>
  <comps>
        <li Class="Seg.HediffCompProperties_SkillOffset">
            <skills>
                <li>
                    <skill>Mining</skill>
                    <offset>-4</offset>
                </li>
                <li>
                    <skill>Animals</skill>
                    <offset>5</offset>
                </li>
                
                <li>
                    <skill>Plants</skill>
                    <offset>3</offset>
                </li>
                <li>
                    <skill>Artistic</skill>
                    <offset>-4</offset>
                </li>
                 <li>
                    <skill>Medicine</skill>
                    <offset>-4</offset>
                </li>
                <li>
                    <skill>Melee</skill>
                    <offset>5</offset>
                </li>
            </skills>
        </li>
    </comps>



  <stages>
    <li>
      <statOffsets>
        
        <PlantWorkSpeed>0.50</PlantWorkSpeed>
        <PlantHarvestYield>-0.1</PlantHarvestYield>
        <MiningSkillOffset>-4</MiningSkillOffset>
        <AnimalsSkillOffset>5</AnimalsSkillOffset>  
        <PlantsSkillOffset>3</PlantsSkillOffset>
        <ArtisticSkillOffset>-4</ArtisticSkillOffset>
        <MedicineSkillOffset>-4</MedicineSkillOffset>
        <MeleeSkillOffset>5</MeleeSkillOffset>

      </statOffsets>
      <painOffset>0.03</painOffset>
    </li>
  </stages>
</HediffDef>

 <AbilityDef>
    <defName>Seg_Servitors_PlasmaShot</defName>
    <label>Servitor Plasma shot</label>
    <description>Fire a burst of low-accuracy energy bolts.</description>
    <writeCombatLog>True</writeCombatLog>
    <iconPath>Things/Item/Health/UI/Icons/Seg_COTO_Plasma</iconPath>
    <showPsycastEffects>False</showPsycastEffects>
    <cooldownTicksRange>180~240</cooldownTicksRange> 
    <verbProperties>
      <verbClass>Verb_AbilityShoot</verbClass>
      <defaultProjectile>SEG_COTO_Bullet_Plasma</defaultProjectile>
      <range>24.9</range>
      <soundCast>Seg_COTO_PlasmaSound</soundCast>
      <muzzleFlashScale>9</muzzleFlashScale>
      <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
      <warmupTime>1</warmupTime>
      <burstShotCount>3</burstShotCount>
      <accuracyTouch>0.9</accuracyTouch>
      <accuracyShort>0.8</accuracyShort>
      <accuracyMedium>0.6</accuracyMedium>
      <accuracyLong>0.5</accuracyLong>
      <ai_IsWeapon>true</ai_IsWeapon>
    </verbProperties>
  </AbilityDef>

  <HediffDef ParentName="AddedBodyPartBase">
