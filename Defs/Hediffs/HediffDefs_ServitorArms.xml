  <hediffClass>Seg.Hediff_SkillOffsetDisplay</hediffClass>
  <addedPartProps>
    <solid>true</solid>
    <partEfficiency>1</partEfficiency>
    <betterThanNatural>true</betterThanNatural>
  </addedPartProps>
  <comps>
        <li Class="Seg.HediffCompProperties_SkillOffset">
            <skills>
                <li>
                    <skill>Mining</skill>
                    <offset>-4</offset>
                </li>
                <li>
                    <skill>Animals</skill>
                    <offset>-4</offset>
                </li>
                
                <li>
                    <skill>Plants</skill>
                    <offset>-4</offset>
                </li>
                <li>
                    <skill>Artistic</skill>
                    <offset>-4</offset>
                </li>
                 <li>
                    <skill>Medicine</skill>
                    <offset>-4</offset>
                </li>
                <li>
                    <skill>Melee</skill>
                    <offset>-4</offset>
                </li>
                  <li>
                      <skill>Shooting</skill>
                      <offset>4</offset>
                  </li>
                  <li>
                      <skill>Cooking</skill>
                      <offset>-4</offset>
                  </li>



