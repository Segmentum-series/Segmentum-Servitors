<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<HediffDef ParentName = "ImplantHediffBase">
		<defName>ServitorizationHediff</defName>
		<label>servitorization</label>
		<labelNoun>a servitorization</labelNoun>
		<description>Once a thinking and feeling bieng, the subject has undergone irreversible servitorization. Higher brain hunctions fave been permanently supressed, leaving only conditioned responses and mechanical obedience. The body remains functional. The person does not.</description>
		<descriptionHyperlinks>
			<ThingDef>servitorChip</ThingDef>
			<RecipeDef>InstallServitorChip</RecipeDef>
		</descriptionHyperlinks>
		<isBad>true</isBad>
		<stages>
			<li>
				<disabledWorkTags> Firefighting, Intellectual, Social, Artistic, Caring, Animals, Hunting </disabledWorkTags>
				<hungerRateFactor>0.25</hungerRateFactor>
				<statOffsets>
					<Beauty>-0.5</Beauty>
					<GlobalLearningFactor>-1</GlobalLearningFactor>
					<MentalBreakThreshold>-0.80</MentalBreakThreshold>
					<PsychicSensitivity>-0.95</PsychicSensitivity>
					<ShootingAccuracyPawn>-0.5</ShootingAccuracyPawn>
					<SocialImpact>-1</SocialImpact>
				</statOffsets>
			
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.6</offset>
					</li>
					<li>
						<capacity>Talking</capacity>
						<offset>-1.0</offset>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="ServitorMod.HediffCompProperties_Servitor"/>
		</comps>
	</HediffDef>
</Defs>