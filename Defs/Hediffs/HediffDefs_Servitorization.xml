					<li>Animals</li>
					<li>Hunting</li>
					<li>Cooking</li>
					<li>PlantWork</li>
					<li>Crafting</li>
					<li>Mining</li>
				</disabledWorkTags>
				<hungerRateFactor>0.25</hungerRateFactor>
				<statOffsets>
