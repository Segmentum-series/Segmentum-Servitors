<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Servitor -->
	<HediffDef ParentName="ImplantHediffBase">
		<defName>Seg_Servitors_ServitorizationHediff</defName>
		<label>servitorization</label>
		<labelNoun>a servitorization</labelNoun>
		<description>Once a thinking and feeling being, this subject has undergone irreversible servitorization. Higher brain functions have been permanently suppressed, leaving only conditioned responses and mechanical obedience. The body remains functional. The person does not.</description>
		<descriptionHyperlinks>
			<ThingDef>Seg_Servitors_ServitorChip</ThingDef>
			<RecipeDef>InstallSeg_Servitors_ServitorChip</RecipeDef>
		</descriptionHyperlinks>
		<isBad>true</isBad>
		<stages>
			<li>
				<disablesNeeds>
					<li>Outdoors</li>
					<li>Indoors</li>
					<li>Rest</li>
					<li>Comfort</li>
					<li>Beauty</li>
					<li>Joy</li>
					<li>Mood</li>
				</disablesNeeds>
				<disabledWorkTags>
					<li>Firefighting</li>
					<li>Intellectual</li>
					<li>Social</li>
					<li>Artistic</li>
					<li>Caring</li>
					<li>Animals</li>
					<li>Hunting</li>
				</disabledWorkTags>
				<hungerRateFactor>0.25</hungerRateFactor>
				<statOffsets>
					<Beauty>-1</Beauty>
					<GlobalLearningFactor>-1</GlobalLearningFactor>
					<MentalBreakThreshold>-0.80</MentalBreakThreshold>
					<PsychicSensitivity>-0.95</PsychicSensitivity>
					<ShootingAccuracyPawn>-0.5</ShootingAccuracyPawn>
					<SocialImpact>-1</SocialImpact>
				</statOffsets>
				<statFactors>
					<MarketValue>0.2</MarketValue>
				</statFactors>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.6</offset>
					</li>
					<li>
						<capacity>Talking</capacity>
						<offset>-1.0</offset>
					</li>
				</capMods>
			</li>
		</stages>
		<comps>
			<li Class="ServitorMod.HediffCompProperties_Servitor" />
		</comps>
		<renderNodeProperties>
			<li>
			<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
			<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
			<texPath>Pawn/Wounds/Seg_SERV_ServitorHead</texPath>
			<drawSize>1</drawSize>
			<parentTagDef>Head</parentTagDef>
			<useSkinShader>false</useSkinShader>
			<useRottenColor>false</useRottenColor>
			<rotDrawMode>Fresh, Rotting</rotDrawMode>
			<drawData>
			<defaultData>
				<layer>69</layer>
				<offset>(0,0,0)</offset>
			</defaultData>
			</drawData>
		</li>
    	</renderNodeProperties>
	</HediffDef>

	<!-- Servitor-Lexomat -->
