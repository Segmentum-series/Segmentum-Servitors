			<ThingDef>Seg_Servitors_LexomatChip</ThingDef>
			<RecipeDef>InstallSeg_Servitors_LexomatChip</RecipeDef>
		</descriptionHyperlinks>
		<isBad>true</isBad>
		<stages>
			<li>
				<disablesNeeds>
					<li>Outdoors</li>
					<li>Indoors</li>
					<li>Rest</li>
					<li>Comfort</li>
					<li>Beauty</li>
					<li>Joy</li>
					<li>Mood</li>
				</disablesNeeds>
				<disabledWorkTags>
