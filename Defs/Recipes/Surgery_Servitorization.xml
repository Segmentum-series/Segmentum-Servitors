<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<!-- Servitor -->
	<RecipeDef ParentName="SurgeryInstallImplantBase">
		<defName>InstallSeg_Servitors_ServitorChip</defName>
		<label>install servitor chip</label>
		<workerClass>ServitorMod.RecipeWorker_Servitor</workerClass>
		<description>Conduct servitorization procedure. Involves invasive neurosurgery, implantation of a control chip, and the irreversible suppression of higher brain functions. The subject is stripped of identity and autonomy, reduced to conditioned obedience.</description>
		<descriptionHyperlinks>
			<ThingDef>Seg_Servitors_ServitorChip</ThingDef>
			<HediffDef>Seg_Servitors_ServitorizationHediff</HediffDef>
		</descriptionHyperlinks>
		<jobString>Conducting servitorization.</jobString>
		<anesthetize>true</anesthetize>
		<surgerySuccessChanceFactor>0.9</surgerySuccessChanceFactor>
		<deathOnFailedSurgeryChance>1</deathOnFailedSurgeryChance>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Seg_Servitors_ServitorChip</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<categories>
						<li>Medicine</li>
					</categories>
				</filter>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>Medicine</li>
			</categories>
			<thingDefs>
				<li>Seg_Servitors_ServitorChip</li>
			</thingDefs>
		</fixedIngredientFilter>
		<appliedOnFixedBodyParts>
			<li>Brain</li>
		</appliedOnFixedBodyParts>
		<addsHediff>Seg_Servitors_ServitorizationHediff</addsHediff>
	</RecipeDef>

