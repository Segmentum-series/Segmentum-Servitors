<Defs>

<ThingDef ParentName="Seg_Servitors_ServitorBase">
	<defName>Seg_Servitors_MiningArm</defName>
	<label>servitor mining arm</label>
	<description>An augmetic replacement arm designed for mining servitors. The arm is composed of industrial micro-las emitters, several drill bits, scoops, and filters to sieve rare minerals from less valuable rock.</description>
	<statBases>
		<MarketValue>2800</MarketValue>
		<Mass>0.3</Mass>
	</statBases>
	<tradeTags Inherit="False">
		<li>Seg_Servitors_Arms</li>
	</tradeTags>
    <techHediffsTags Inherit="False">
		<li>Seg_Servitors_Arms</li>
	</techHediffsTags>
	<costList>
		<Plasteel>20</Plasteel>
		<ComponentIndustrial>6</ComponentIndustrial>
		<ComponentSpacer>1</ComponentSpacer>
		<Seg_Ceramite>25</Seg_Ceramite>
	</costList>
    <recipeMaker>
      <researchPrerequisites MayRequire="Ludeon.RimWorld.Royalty">
	  <li>SpecializedLimbs</li>
      </researchPrerequisites>
	</recipeMaker>
</ThingDef>

