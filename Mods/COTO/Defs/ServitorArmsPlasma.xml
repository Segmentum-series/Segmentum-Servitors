<Defs>
<!--Heddifs-->
<AbilityDef>
    <defName>Seg_Servitors_PlasmaShot</defName>
    <label>Servitor Plasma shot</label>
    <description>Fire a burst of low-accuracy energy bolts.</description>
    <writeCombatLog>True</writeCombatLog>
    <iconPath>Things/Item/Health/UI/Icons/Seg_COTO_Plasma</iconPath>
    <showPsycastEffects>False</showPsycastEffects>
    <cooldownTicksRange>180~240</cooldownTicksRange> 
    <verbProperties>
      <verbClass>Verb_AbilityShoot</verbClass>
      <defaultProjectile>SEG_COTO_Bullet_Plasma</defaultProjectile>
      <range>24.9</range>
      <soundCast>Seg_COTO_PlasmaSound</soundCast>
      <muzzleFlashScale>9</muzzleFlashScale>
      <ticksBetweenBurstShots>120</ticksBetweenBurstShots>
      <warmupTime>4</warmupTime>
      <burstShotCount>3</burstShotCount>
      <accuracyTouch>0.9</accuracyTouch>
      <accuracyShort>0.8</accuracyShort>
      <accuracyMedium>0.6</accuracyMedium>
      <accuracyLong>0.5</accuracyLong>
      <ai_IsWeapon>true</ai_IsWeapon>
    </verbProperties>
  </AbilityDef>

  <HediffDef ParentName="AddedBodyPartBase">
  <defName>Seg_Servitors_PlasArm_Hediff</defName>
  <label>servitor plasma-arm</label>
  <labelNoun>a plasma-equipped servitor arm</labelNoun>
  <description>An installed augmetic replacement arm. The servitor plasma-arm has a built-in plasma cannon for defense and combat. The fingers are replaced with multiple mechascythes that greatly speed up gathering work, but destroy a small amount of the harvest.</description>
  <spawnThingOnRemoved>Seg_Servitors_PlasArm</spawnThingOnRemoved>
  <hediffClass>Seg.Hediff_SkillOffsetDisplay</hediffClass>
  <addedPartProps>
    <solid>true</solid>
    <partEfficiency>1</partEfficiency>
    <betterThanNatural>true</betterThanNatural>
  </addedPartProps>
  <comps>
        <li Class="Seg.HediffCompProperties_SkillOffset">
            <skills>
                <li>
                    <skill>Mining</skill>
                    <offset>-4</offset>
                </li>
                <li>
                    <skill>Animals</skill>
                    <offset>-4</offset>
                </li>
                
                <li>
                    <skill>Plants</skill>
                    <offset>-4</offset>
                </li>
                <li>
                    <skill>Artistic</skill>
                    <offset>-4</offset>
                </li>
                 <li>
                    <skill>Medicine</skill>
                    <offset>-4</offset>
                </li>
                <li>
                    <skill>Melee</skill>
                    <offset>-4</offset>
                </li>
                  <li>
                      <skill>Shooting</skill>
                      <offset>4</offset>
                  </li>
                  <li>
                      <skill>Cooking</skill>
                      <offset>-4</offset>
                  </li>



            </skills>
        </li>
    <li Class="Seg.HediffCompProperties_GivesAbility">
        <ability>Seg_Servitors_PlasmaShot</ability>
    </li>
</comps>
  <stages>
    <li>
      <statOffsets>
        <ShootingSkillOffset>4</ShootingSkillOffset>
        <MiningSkillOffset>-4</MiningSkillOffset>
        <AnimalsSkillOffset>-4</AnimalsSkillOffset>
        <PlantsSkillOffset>-4</PlantsSkillOffset>
        <ArtisticSkillOffset>-4</ArtisticSkillOffset>
        <MedicineSkillOffset>-4</MedicineSkillOffset>
        <MeleeSkillOffset>-4</MeleeSkillOffset>

      </statOffsets>
      <painOffset>0.03</painOffset>
    </li>
  </stages>
</HediffDef>
<!--ThingDefs-->
<ThingDef ParentName="BodyPartBionicBase">
  <defName>Seg_Servitors_PlasArm</defName>
  <label>servitor plasma-arm</label>
 <description>An augmetic replacement arm designed for plasma-equipped servitors. The servitor plasma-arm has a built-in plasma cannon for defense and combat. The fingers are replaced with multiple mechascythes that greatly speed up gathering work, but destroy a small amount of the harvest.</description>
  <statBases>
    <MarketValue>2800</MarketValue>
    <Mass>0.3</Mass>
  </statBases>
  
		<costList>
			<Plasteel>20</Plasteel>
			<ComponentSpacer>8</ComponentSpacer>
      <Seg_Ceramite>25</Seg_Ceramite>
		</costList>
</ThingDef>
<!--RecipeDefs-->
<RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
  <defName>InstallSeg_Servitors_PlasArm</defName>
  <label>install servitor plasma-arm</label>
  <description>Installs an augmetic replacement arm designed for plasma-equipped servitors. The servitor plasma-arm has a built-in plasma cannon for defense and combat. The fingers are replaced with multiple mechascythes that greatly speed up gathering work, but destroy a small amount of the harvest.</description>
  <jobString>Installing servitor plasma-arm.</jobString>
  <ingredients>
    <li>
      <filter>
        <thingDefs>
          <li>Seg_Servitors_PlasArm</li>
        </thingDefs>
      </filter>
      <count>1</count>
    </li>
  </ingredients>
  <fixedIngredientFilter>
    <thingDefs>
      <li>Seg_Servitors_PlasArm</li>
    </thingDefs>
  </fixedIngredientFilter>
  <appliedOnFixedBodyParts>
    <li>Arm</li>
  </appliedOnFixedBodyParts>
  <addsHediff>Seg_Servitors_PlasArm_Hediff</addsHediff>
</RecipeDef>
