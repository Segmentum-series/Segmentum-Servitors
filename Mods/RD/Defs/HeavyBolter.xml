<Defs>
  <!--Heddifs-->
  <AbilityDef>
    <defName>Seg_Servitors_BolterShot</defName>
    <label>Servitor Bolter shot</label>
    <description>Fire a burst of low-accuracy mass reactive bolts.</description>
    <writeCombatLog>True</writeCombatLog>
    <iconPath>Things/Projectiles/BEWH_BolterRound</iconPath>
    <showPsycastEffects>False</showPsycastEffects>
    <cooldownTicksRange>180~240</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_AbilityShoot</verbClass>
      <defaultProjectile>BEWH_BolterRound</defaultProjectile>
      <range>24.9</range>
      <soundCast>Seg_Serv_BolterSound</soundCast>
      <muzzleFlashScale>9</muzzleFlashScale>
      <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
      <warmupTime>2</warmupTime>
      <burstShotCount>6</burstShotCount>
      <accuracyTouch>0.3</accuracyTouch>
      <accuracyShort>0.2</accuracyShort>
      <accuracyMedium>0.1</accuracyMedium>
      <accuracyLong>0.01</accuracyLong>
      <ai_IsWeapon>true</ai_IsWeapon>
    </verbProperties>
    <!--<comps>
      <li Class="Core40k.CompProperties_AmmoChanger">
        <compClass>Core40k.Comp_AmmoChanger</compClass>
        <availableProjectiles>
          <li>BEWH_BolterRound</li>
          <li>BEWH_BolterRoundMetalStorm</li>
          <li>BEWH_BolterRoundInferno</li>
          <li>BEWH_BolterRoundKraken</li>
          <li>BEWH_BolterRoundTempest</li>
        </availableProjectiles>
      </li>
      </comps>-->
  </AbilityDef>
  <HediffDef ParentName="AddedBodyPartBase">
    <defName>Seg_Servitors_BolterArm_Hediff</defName>
    <label>servitor bolter-arm</label>
    <labelNoun>a bolter-equipped servitor arm</labelNoun>
    <description>A weapon attachment which has replaced the limb. The servitor bolter-arm consists of a large bolter for combat but greatly impairs any functions other than combat.</description>
    <spawnThingOnRemoved>Seg_Servitors_BolterArm</spawnThingOnRemoved>
    <hediffClass>Seg.Hediff_SkillOffsetDisplay</hediffClass>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <renderNodeProperties>
            <li>
                <nodeClass>Seg.PawnRenderNode_Arm</nodeClass>
                <workerClass>Seg.PawnRenderNodeWorker_Arm</workerClass>
                <texPath>Pawn/Wounds/HeavyBolter/Seg_SERV_GunArmHBolter</texPath>
                <drawSize>1</drawSize>
                <parentTagDef>Body</parentTagDef>
                <side>Right</side>
                <drawData>
                    <defaultData>
                        <offset>(-.015,0,-.1)</offset>
                        <layer>500</layer>
                    </defaultData>
                    <dataWest>
                        <offset>(-.015,0,-.1)</offset>
                        <layer>0</layer>
                    </dataWest>
                    <dataEast>
                        <offset>(-.015,0,-.1)</offset>
                        <layer>0</layer>
                    </dataEast>
                </drawData>
            </li>
        </renderNodeProperties>
    <comps>
      <li Class="Seg.HediffCompProperties_GivesAbility">
        <vanillaAbility>Seg_Servitors_BolterShot</vanillaAbility>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ShootingSkillOffset>2</ShootingSkillOffset>
          <MiningSkillOffset>-8</MiningSkillOffset>
          <AnimalsSkillOffset>-8</AnimalsSkillOffset>
          <PlantsSkillOffset>-8</PlantsSkillOffset>
          <ArtisticSkillOffset>-8</ArtisticSkillOffset>
          <MedicineSkillOffset>-8</MedicineSkillOffset>
          <MeleeSkillOffset>-8</MeleeSkillOffset>
          <CookingSkillOffset>-8</CookingSkillOffset>
		  <WorkSpeedGlobal>-0.45</WorkSpeedGlobal>
        </statOffsets>
        <painOffset>0.30</painOffset>
      </li>
    </stages>
    <modExtensions>
      <li Class="Seg.DefModExtension_HediffSkillOffset">
        <skills>
          <li>
            <skill>Mining</skill>
            <offset>-8</offset>
          </li>
          <li>
            <skill>Animals</skill>
            <offset>-8</offset>
          </li>

          <li>
            <skill>Plants</skill>
            <offset>-8</offset>
          </li>
          <li>
            <skill>Artistic</skill>
            <offset>-8</offset>
          </li>
          <li>
            <skill>Medicine</skill>
            <offset>-8</offset>
          </li>
          <li>
            <skill>Melee</skill>
            <offset>-8</offset>
          </li>
          <li>
            <skill>Shooting</skill>
            <offset>2</offset>
          </li>
          <li>
            <skill>Cooking</skill>
            <offset>-8</offset>
          </li>
        </skills>
      </li>
    </modExtensions>
  </HediffDef>

  <!--ThingDefs-->

  <ThingDef ParentName="Seg_Servitors_ServitorBase">
    <defName>Seg_Servitors_BolterArm</defName>
    <label>servitor bolter-arm</label>
    <description>A weapon attachment which replaces the existing limb. The servitor bolter-arm consists of a large bolter for combat but greatly impairs any functions other than combat.</description>
    <statBases>
      <MarketValue>2000</MarketValue>
      <Mass>0.3</Mass>
    </statBases>
    <costList>
      <Plasteel>20</Plasteel>
      <ComponentSpacer>3</ComponentSpacer>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Seg_Ceramite>25</Seg_Ceramite>
    </costList>
    <recipeMaker>
      <researchPrerequisites>
        <li>PrecisionRifling</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>

  <!--RecipeDefs-->

  <RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
    <defName>InstallSeg_Servitors_BolterArm</defName>
    <label>install servitor bolter-arm</label>
    <description>Replaces the existing limb with a weapon attachment. The servitor bolter-arm consists of a large bolter for combat but greatly impairs any functions other than combat</description>
    <jobString>Installing servitor bolter-arm.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Seg_Servitors_BolterArm</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Seg_Servitors_BolterArm</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Shoulder</li>
    </appliedOnFixedBodyParts>
    <addsHediff>Seg_Servitors_BolterArm_Hediff</addsHediff>
  </RecipeDef>
	<SoundDef>
		<defName>Seg_Serv_BolterSound</defName>
		<context>MapOnly</context>
		<maxSimultaneous>20</maxSimultaneous>
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>Seg_COTO_Sound_Radium</clipPath>
					</li>
				</grains>
				<volumeRange>30~90</volumeRange>
				<pitchRange>.8~1.4</pitchRange>
			</li>
		</subSounds>
	</SoundDef>
</Defs>